# Copia este archivo como .env.local y llena los valores.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# IA de Nuna: "deepseek", "openai", "anthropic" o "rules" (sin IA).
# Si no lo defines, usa la primera llave que exista (DeepSeek, luego Claude); sin llaves, reglas.
NUNA_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com   (otro proveedor compatible, p. ej. con servidores en EE.UU.)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6.1-sol   (cerebro con OpenAI; usa la misma OPENAI_API_KEY de la voz)

# Precio del kit de marca (texto que ve el dueño). Modo prueba: no se cobra.
# BRAND_KIT_PRICE=US$49

# Recraft (recraft.ai): la IA que dibuja el símbolo único de cada marca, en vector (SVG).
# Sin esta llave, Nuna usa los símbolos geométricos.
RECRAFT_API_KEY=
# RECRAFT_MODEL=recraftv4_1_vector

# OpenAI: voz de Nuna en la entrevista (voz natural y transcripción de lo que dice el dueño).
# Sin esta llave se usa la voz del navegador. ~US$0.10 por entrevista completa.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin        (otras: cedar, coral, nova, sage, shimmer…)
# OPENAI_STT_MODEL=gpt-transcribe
